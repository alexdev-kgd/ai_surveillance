# RuSender API token with the external_mail.send permission.
RUSENDER_API_TOKEN=

# The sender must use the verified domain associated with the sending key.
EMAIL_FROM=noreply@example.ru
EMAIL_FROM_NAME=AI Surveillance
EMAIL_TO=alerts@example.ru

# Optional settings.
NOTIFY_INTERVAL=60
RUSENDER_TIMEOUT_SECONDS=10
# Required: generate locally with python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated exact browser origins. Empty disables cross-origin access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
