# Gmail SMTP. Use an App Password, not the ordinary Google account password.
# Create one at https://myaccount.google.com/apppasswords (2FA must be on).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.account@gmail.com
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10

# For Gmail, EMAIL_FROM must be the same address as SMTP_USER (or an allowed alias).
EMAIL_FROM=your.account@gmail.com
EMAIL_FROM_NAME=Видеонаблюдение магазина
EMAIL_TO=alerts@example.ru

# SMS Aero (https://smsaero.ru/integration/documentation/api/)
# API key: https://smsaero.ru/cabinet/settings/apikey/
SMSAERO_EMAIL=
SMSAERO_API_KEY=
SMSAERO_PHONE=79506781834
SMSAERO_SIGN=SMS Aero
SMSAERO_TIMEOUT_SECONDS=10
# Set to true to call sms/testsend instead of a live send.
SMSAERO_TEST_MODE=

# Optional settings.
NOTIFY_INTERVAL=60
# Required: generate locally with python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Comma-separated exact browser origins. Empty disables cross-origin access.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
